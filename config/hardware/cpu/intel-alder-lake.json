{
  "schemaVersion": 1,
  "id": "intel-alder-lake",
  "description": "Intel 12th generation Core processors.",
  "match": {
    "cpuVendor": "GenuineIntel",
    "cpuNameRegex": "(?i)12th Gen Intel.*"
  },
  "capabilities": {
    "cpu": true,
    "cpuArchitecture": "AlderLake",
    "requiresCpuIdEmulation": true,
    "requiresProvideCurrentCpuInfo": true
  },
  "opencore": {
    "plist": {
      "Kernel": {
        "Emulate": {
          "Cpuid1Data": {
            "type": "data",
            "format": "hex",
            "value": "55060A00000000000000000000000000"
          },
          "Cpuid1Mask": {
            "type": "data",
            "format": "hex",
            "value": "FFFFFFFF000000000000000000000000"
          },
          "MinKernel": {
            "type": "string",
            "value": "19.0.0"
          }
        },
        "Quirks": {
          "ProvideCurrentCpuInfo": {
            "type": "boolean",
            "value": true
          }
        }
      }
    }
  }
}
